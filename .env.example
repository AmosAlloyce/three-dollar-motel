# npm start reads .env. Keep that file private.
HOST=127.0.0.1
PORT=3000
MAX_PLAYERS=20
# npm start defaults to ./data. Docker Compose supplies its persistent volume path.
MOTEL_DATA_DIR=
MOTEL_NAME=Three Dollar Motel

# Local preview: leave blank. Deployment: https://your-hostname (no trailing slash).
PUBLIC_ORIGIN=

# Leave blank to disable host controls locally. Set a long random key before deployment.
ADMIN_KEY=

# Leave blank until the actual Solana mint has been created and verified.
# Setting a mint enables a Pump.fun link; it does not create or verify a token.
COIN_MINT=
COIN_TICKER=TDM

# Keep false behind Caddy: Node sees the proxy address, not individual guest IPs.
BAN_BY_IP=false

# Deployment only: your domain/free subdomain, without https:// or a path.
MOTEL_DOMAIN=
PORTFOLIO_DOMAIN=amos-alloyce-portfolio.duckdns.org
