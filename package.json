{
  "name": "three-dollar-motel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small shared browser hotel with live avatars and chat.",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs"
  }
}
